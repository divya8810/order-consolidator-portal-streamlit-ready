# Copy this file to .env and adjust if needed. All values have working
# defaults, so .env is optional for local use.

# Flask secret key (used for flash messages / sessions)
SECRET_KEY=change-me

# SQLAlchemy database URL. Defaults to a local SQLite file.
# For Postgres, e.g.: postgresql://user:password@localhost:5432/portal
DATABASE_URL=sqlite:///portal.db

# Max upload size in megabytes (applies to the whole request, i.e. all files combined)
MAX_UPLOAD_MB=25
